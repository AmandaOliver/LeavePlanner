# Copy to .env.development for local dev, and .env.local for the e2e credentials.
# Both are gitignored. See README.md > Configuration.

REACT_APP_API_SERVER_URL=https://localhost:7247
REACT_APP_AUTH0_DOMAIN=your-tenant.eu.auth0.com
REACT_APP_AUTH0_CLIENT_ID=
REACT_APP_AUTH0_CALLBACK_URL=https://localhost:3000/home
REACT_APP_AUTH0_AUDIENCE=https://api.leaveplanner.org

# Generate the certificate with `yarn setup:certs`.
SSL=true
HTTPS=true
SSL_CRT_FILE=./localhost.crt
SSL_KEY_FILE=./localhost.key

E2E_BASE_URL=https://localhost:3000
E2E_USER=
E2E_PASSWORD=
