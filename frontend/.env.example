# Copy to .env.development (local dev) and .env.local (e2e credentials), then fill in.
# Both are gitignored. Nothing in this file is a secret except E2E_PASSWORD.

# --- App configuration -------------------------------------------------------
# Where the API is reachable. Local: https://localhost:7247
REACT_APP_API_SERVER_URL=https://localhost:7247

# Auth0 tenant. The SPA client ID is public by design -- it ships in the JS bundle
# and is not a secret. It lives here because it is environment-specific, so dev,
# test and production can point at separate tenants.
REACT_APP_AUTH0_DOMAIN=your-tenant.eu.auth0.com
REACT_APP_AUTH0_CLIENT_ID=
REACT_APP_AUTH0_CALLBACK_URL=https://localhost:3000/home
# Must match Auth0:Audience in the API configuration.
REACT_APP_AUTH0_AUDIENCE=https://api.leaveplanner.org

# --- Local HTTPS -------------------------------------------------------------
# Generate the certificate with `yarn setup:certs` (see README).
SSL=true
HTTPS=true
SSL_CRT_FILE=./localhost.crt
SSL_KEY_FILE=./localhost.key

# --- E2E test credentials (put these in .env.local) --------------------------
# A user in your Auth0 TEST tenant, created via a database connection so the suite
# never drives Google's sign-in page. E2E_PASSWORD is a secret.
E2E_BASE_URL=https://localhost:3000
E2E_USER=
E2E_PASSWORD=
